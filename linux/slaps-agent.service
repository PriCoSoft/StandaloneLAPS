[Unit]
Description=Standalone LAPS agent (SLAPS password rotation)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/slaps/settings.json

[Service]
Type=simple
ExecStart=/usr/sbin/slaps-agent run
Restart=on-failure
RestartSec=60
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
