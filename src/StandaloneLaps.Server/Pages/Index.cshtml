@page "/"
@model IndexModel
@{
    ViewData["Title"] = Model.ShowDeleted ? "Deleted devices" : "Devices";
    var identity = Model.Identity;
    var none = Guid.Empty;
}
<main class="content @(Model.Selected != null ? "with-drawer" : "")">
<div class="breadcrumbs">SLAPS <span>/</span> @ViewData["Title"]</div>
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATOR RECOVERY</p><h1>@ViewData["Title"]<span class="count">@Model.Devices.Length</span></h1><p class="subtitle">@(Model.ShowDeleted ? "Restore an archived device and its agent access." : "Browse devices and securely recover local administrator credentials.")</p></div>
@if (identity.IsAdmin && !Model.ShowDeleted) {<a class="button" href="addclient">Add client</a>} else {<span class="role-label">@(identity.IsAdmin ? "Manage access" : "Read access")</span>}</div>
<div class="list-card">
<form class="search-toolbar" method="get">@if (Model.ShowDeleted) {<input type="hidden" name="view" value="deleted" />}<label class="search-box"><span aria-hidden="true">⌕</span><input type="search" name="q" value="@Model.Query" placeholder="Search by device name or ID" aria-label="Search devices" maxlength="200" /></label><button class="button secondary" type="submit">Search</button>@if (!string.IsNullOrEmpty(Model.Query)) {<a class="text-link" href="@(Model.ShowDeleted ? "./?view=deleted" : "./")">Clear</a>}<span class="results">@Model.Devices.Length @(Model.Devices.Length == 1 ? "device" : "devices")</span></form>
<div class="table-scroll"><table class="device-table"><thead><tr><th>Device name</th><th>Last backup (UTC)</th><th>Status</th><th class="number">Versions</th><th><span class="sr-only">Details</span></th></tr></thead><tbody>
@foreach (var device in Model.Devices)
{
    var link = Model.DeviceUrl(Guid.Parse(device.DeviceId), "overview", none, false);
    <tr class="@(Model.Selected != null && Model.Selected.DeviceId == device.DeviceId ? "selected-row" : "")"><td><a class="device-link" href="@link"><span class="device-icon" aria-hidden="true"></span><span><strong>@device.Name</strong><small>@device.DeviceId</small></span></a></td><td class="date-cell">@PortalPage.DateLabel(device.LastBackupUtc)</td><td><span class="badge @(device.Deleted ? "neutral" : device.Unconfirmed ? "warning" : device.Versions == 0 ? "neutral" : "success")"><span></span>@IndexModel.Status(device)</span></td><td class="number">@device.Versions<span class="muted"> / @Model.Limit</span></td><td><a class="row-open" aria-label="Open @device.Name" href="@link">›</a></td></tr>
}
</tbody></table></div>
@if (Model.Devices.Length == 0) {<div class="empty-state"><span class="empty-icon">⌕</span><h2>@(string.IsNullOrEmpty(Model.Query) ? "No devices here yet" : "No matching devices")</h2><p>@(string.IsNullOrEmpty(Model.Query) ? "Devices added with \"Add client\" appear here. Deleted devices can be restored by an administrator." : "Try a different device name or part of its ID.")</p></div>}
<div class="list-footer"><span>@(string.IsNullOrEmpty(Model.Query) ? "All configured devices" : "Filtered results")</span><span>History is limited to @Model.Limit versions</span></div></div>
<p class="identity">Signed in as @identity.DisplayName · @identity.Actor</p>
</main>
@if (Model.Selected != null)
{
    var selected = Model.Selected;
    var close = Model.DeviceUrl(none, "overview", none, false);
<a class="drawer-backdrop" href="@close" aria-label="Close device details"></a>
<aside class="drawer" aria-labelledby="device-title"><div class="drawer-top"><div class="drawer-breadcrumb">Devices <span>/</span> @selected.Name</div><a class="close-button" href="@close" aria-label="Close device details">×</a></div>
<div class="drawer-heading"><span class="device-icon large" aria-hidden="true"></span><div><h2 id="device-title">@selected.Name</h2><p>Standalone @(selected.Platform == "linux" ? "Linux" : "Windows") device</p></div></div>
<div class="drawer-actions">@if (identity.IsAdmin && !Model.ShowDeleted) {<span class="drawer-links"><a href="addclient?device=@Model.Device">New certificate package</a><a class="delete-link" href="@Model.DeviceUrl(Model.Device, "overview", none, true)">Delete device</a></span>}<span class="badge @(Model.ShowDeleted ? "neutral" : selected.Unconfirmed ? "warning" : selected.Versions == 0 ? "neutral" : "success")"><span></span>@IndexModel.Status(selected)</span></div>
<nav class="tabs" aria-label="Device sections"><a class="@(Model.Tab == "overview" ? "active" : "")" href="@Model.DeviceUrl(Model.Device, "overview", none, false)">Overview</a>@if (!Model.ShowDeleted) {<a class="@(Model.Tab == "history" ? "active" : "")" href="@Model.DeviceUrl(Model.Device, "history", none, false)">Password history <span>@Model.Entries.Length</span></a>}</nav>
<div class="drawer-body">
@if (Model.ConfirmDelete)
{
<section class="notice danger"><h3>Delete this device?</h3><p>The device disappears from the active list and its agent is blocked. Encrypted history is kept and can be restored by an administrator.</p><form method="post"><label class="field-label" for="confirmName">Type <strong>@selected.Name</strong> to confirm</label><input class="text-input" id="confirmName" name="confirmName" autocomplete="off" required /><div class="form-actions"><button class="button destructive" type="submit" name="action" value="delete">Delete device</button><a href="@Model.DeviceUrl(Model.Device, "overview", none, false)">Cancel</a></div></form></section>
}
@if (Model.ShowDeleted)
{
<section class="notice"><h3>This device is deleted</h3><p>Its encrypted records are kept. Restore it to view history and allow its agent certificate to upload again.</p><form method="post"><label class="checkbox"><input type="checkbox" name="confirmRestore" value="yes" required />Restore this device and its agent access.</label><button class="button" type="submit" name="action" value="restore">Restore device</button></form></section>
}
else if (Model.Tab == "overview")
{
<section class="detail-section"><h3>Device information</h3><dl><dt>Device name</dt><dd>@selected.Name</dd><dt>Device ID</dt><dd class="mono">@Model.Device</dd><dt>Last backup</dt><dd>@PortalPage.DateLabel(selected.LastBackupUtc) @(selected.LastBackupUtc == null ? "" : "UTC")</dd><dt>Last applied report</dt><dd>@PortalPage.DateLabel(selected.LastAppliedUtc) @(selected.LastAppliedUtc == null ? "" : "UTC")</dd><dt>Retained versions</dt><dd>@Model.Entries.Length of @Model.Limit</dd></dl></section>
<section class="detail-section"><h3>Protection</h3><dl><dt>Password encryption</dt><dd>AES-256-GCM</dd><dt>Recovery key protection</dt><dd>RSA-OAEP-SHA256</dd><dt>Agent certificate SHA-256</dt><dd class="mono fingerprint">@selected.CertificateSha256</dd><dt>Storage</dt><dd>@(Model.Store.IsPostgres ? "PostgreSQL" : "SQLite") database</dd></dl><p class="helper">Records are encrypted for the recovery certificate. Its private key is stored encrypted with the server's master key, not in plain form.</p></section>
<a class="button inline" href="@Model.DeviceUrl(Model.Device, "history", none, false)">View password history</a>
}
else
{
<div class="section-heading"><h3>Password history</h3><span class="muted">@Model.Entries.Length / @Model.Limit versions</span></div><p class="helper">An unconfirmed candidate may already be active after an interrupted rotation. Applied status is reported by the agent.</p>
<div class="history-list">
@foreach (var entry in Model.Entries)
{
<a class="history-item @(Model.Rotation == entry.rotationId ? "chosen" : "")" href="@Model.DeviceUrl(Model.Device, "history", entry.rotationId, false)"><span class="history-marker @(entry.appliedReportedUtc == null ? "pending" : "")"></span><span class="history-content"><strong>@PortalPage.DateLabel(entry.createdUtc) UTC</strong><span class="badge @(entry.appliedReportedUtc == null ? "warning" : "success")">@(entry.appliedReportedUtc == null ? "Unconfirmed" : "Reported applied")</span><small>@entry.rotationId</small></span><span class="history-chevron">›</span></a>
}
</div>
@if (Model.Entries.Length == 0) {<div class="empty-panel"><h3>No password versions yet</h3><p>The first successful agent backup will appear here.</p></div>}
@if (Model.SelectedRecord != null)
{
<section class="recovery-card"><h3>Recover selected version</h3><p class="mono">@Model.Rotation</p><dl><dt>Recovery certificate SHA-256</dt><dd class="mono fingerprint">@Model.SelectedRecord.Envelope.recipientSha256</dd></dl><a class="button secondary inline" href="download?device=@Model.Device&amp;rotation=@Model.Rotation">Download encrypted envelope</a><form method="post"><button class="button" name="action" value="reveal" type="submit">Reveal password</button></form>
@if (!string.IsNullOrEmpty(Model.Message)) {<p class="notice">@Model.Message</p>}
@if (Model.Secret != null) {<div class="secret"><strong>@Model.Account</strong><code>@Model.Secret</code><p>Close this page after use.</p></div>}
</section>
}
}
</div><footer class="drawer-footer">Encrypted recovery · Access is audited</footer></aside>
}
