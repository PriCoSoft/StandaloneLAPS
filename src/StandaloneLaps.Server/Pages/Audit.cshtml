@page "/audit"
@model AuditModel
@using StandaloneLapsWeb
@{
    ViewData["Title"] = "Audit log";
}
<main class="content">
<div class="breadcrumbs">SLAPS <span>/</span> Audit log</div>
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATION · READ-ONLY</p><h1>Audit log</h1><p class="subtitle">Who revealed which password, signed in, changed settings or managed devices. Newest first; times in UTC.</p></div><span class="role-label">Manage access</span></div>
<div class="list-card">
<form class="search-panel" method="get">
<div class="filter-row">
<label class="filter-field grow"><span class="field-label">Search</span><span class="search-box wide"><span aria-hidden="true">&#8981;</span><input type="search" name="q" value="@Model.Query" placeholder="User, device, computer, action…" maxlength="128" /></span></label>
<label class="filter-field"><span class="field-label">Events</span><select class="select-input" name="category">
@foreach (var option in AuditFormat.Categories)
{
if (option.Key == Model.Category) {<option value="@option.Key" selected>@option.Value</option>} else {<option value="@option.Key">@option.Value</option>}
}
</select></label>
<label class="filter-field"><span class="field-label">From</span><input class="text-input date-input" type="date" name="from" value="@Model.From" /></label>
<label class="filter-field"><span class="field-label">To</span><input class="text-input date-input" type="date" name="to" value="@Model.To" /></label>
<div class="filter-actions"><button class="button" type="submit">Filter</button><a class="text-link" href="audit">Clear</a></div>
</div>
<p class="search-hint">Text matches user names, IDs, devices, computers and actions. Export downloads up to @AuditFormat.ExportLimit matching entries as CSV; exports are audited.</p>
</form>
@if (Model.Entries.Count == 0)
{
<div class="empty-state compact"><span class="empty-icon">&#9783;</span><h2>No audit entries</h2><p>@(Model.Filtered ? "Nothing matches this filter." : "Nothing has been recorded yet.")</p></div>
}
else
{
<div class="table-scroll"><table class="device-table audit-table sortable" data-table-key="audit"><thead><tr><th data-sort="text">Time (UTC)</th><th data-sort="text">User / client</th><th data-sort="text">Event</th><th data-sort="text">Target</th></tr></thead><tbody>
@foreach (var entry in Model.Entries)
{
<tr>
<td class="date-cell" data-sort-value="@entry.Utc.UtcDateTime.ToString("yyyy-MM-ddTHH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)">@entry.Utc.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)</td>
<td>@Html.Raw(AuditFormat.ActorHtml(entry, Model.Names))</td>
<td>@Html.Raw(AuditFormat.EventHtml(entry))</td>
<td>@Html.Raw(AuditFormat.TargetHtml(entry, Model.Names, "./?device="))</td>
</tr>
}
</tbody></table></div>
}
<div class="list-footer"><span>Page @Model.PageNumber · @Model.Entries.Count @(Model.Entries.Count == 1 ? "entry" : "entries") on this page</span><span class="pager">@if (Model.PageNumber > 1) {<a href="@Model.Link(Model.PageNumber - 1, null)">‹ Newer</a>}@if (Model.More) {<a href="@Model.Link(Model.PageNumber + 1, null)">Older ›</a>}<a href="@Model.Link(1, "csv")">Export CSV</a></span></div>
</div>
<p class="helper">Stored in the database table <code>slaps_audit</code> (not tamper-evident). Copying a password to the clipboard is not audited, revealing it is.</p>
<p class="identity">Signed in as @Model.Identity.DisplayName · @Model.Identity.Actor</p>
</main>
