@page "/windowslaps"
@model WindowsLapsModel
@{
    ViewData["Title"] = "Windows LAPS";
    var identity = Model.Identity;
    var laps = Model.Laps;
}
<main class="content @(Model.Selected != null ? "with-drawer" : "")">
<div class="breadcrumbs">SLAPS <span>/</span> Windows LAPS</div>
<div class="page-heading"><div><p class="eyebrow">DIRECTORY LOOKUP · READ-ONLY</p><h1>Windows LAPS</h1><p class="subtitle">Find a domain-joined or Entra-joined computer and show the password that Windows LAPS or legacy Microsoft LAPS stored for it.</p></div><span class="role-label">@(identity.IsAdmin ? "Manage access" : "Read access")</span></div>
<div class="source-chips"><span class="chip @(laps.AdEnabled ? "on" : "")">Active Directory: @(laps.AdEnabled ? "on" : "off")</span><span class="chip @(laps.EntraEnabled ? "on" : "")">Microsoft Entra ID: @(laps.EntraEnabled ? "on" : "off")</span></div>
<div class="list-card">
<form class="search-panel" method="get"><label class="field-label" for="laps-query">Computer</label><div class="search-row"><label class="search-box wide"><span aria-hidden="true">⌕</span><input id="laps-query" type="search" name="q" value="@Model.Query" placeholder="e.g. SRV-APP01, srv-app01.corp.example or SRV-*" maxlength="128" autofocus /></label><button class="button" type="submit">Search</button>@if (Model.Searched) {<a class="text-link" href="windowslaps">Clear</a><span class="results">@Model.Results.Count @(Model.Results.Count == 1 ? "computer" : "computers")</span>}</div>
<p class="search-hint">Name, DNS name or Entra device ID. End with <code>*</code> to search by prefix. Only computers with a stored LAPS password are listed (max. @WindowsLapsService.MaxResults per directory).</p></form>
@foreach (var error in Model.Errors) {<p class="notice danger inset">@error</p>}
@if (Model.Results.Count > 0)
{
<div class="table-scroll"><table class="device-table sortable" data-table-key="windowslaps"><thead><tr><th data-sort="text">Computer</th><th data-sort="text">Description</th><th data-sort="text">Directory</th><th data-sort="text">Stored passwords</th><th data-sort="text">Password expires (UTC)</th><th class="no-sort"><span class="sr-only">Open</span></th></tr></thead><tbody>
@foreach (var computer in Model.Results)
{
    var link = Model.Url(computer, "password");
    var expires = computer.ExpiresUtc ?? computer.LegacyExpiresUtc;
<tr class="@(Model.Selected != null && Model.Selected.Source == computer.Source && Model.Selected.Id == computer.Id ? "selected-row" : "")"><td><a class="device-link" href="@link"><span class="device-icon" aria-hidden="true"></span><span><strong>@computer.Name</strong><small>@(computer.DnsName ?? computer.OperatingSystem ?? computer.Id)</small></span></a></td><td class="description-cell">@computer.Description</td><td><span class="source-badge @computer.Source">@WindowsLapsModel.SourceName(computer.Source)</span></td><td class="kinds-cell">@WindowsLapsModel.Kinds(computer)</td><td class="date-cell" data-sort-value="@WindowsLapsModel.Sort(expires)">@CredentialHtml.Utc(expires)</td><td><a class="row-open" aria-label="Open @computer.Name" href="@link">›</a></td></tr>
}
</tbody></table></div>
}
else if (Model.Searched && Model.Errors.Count == 0)
{
<div class="empty-state compact"><span class="empty-icon">⌕</span><h2>No computer with a LAPS password found</h2><p>Check the name, search by prefix with * at the end, or check that the service account may read the LAPS attributes of that OU.</p></div>
}
else if (!Model.Searched)
{
<div class="empty-state compact"><span class="empty-icon">⌕</span><h2>Search for a computer</h2><p>Passwords are read live from the directory and never stored by SLAPS.</p></div>
}
<div class="list-footer"><span>Read-only · every search and reveal is audited</span><span>@(laps.ReaderAllowed ? "Readers and administrators" : "Administrators only")</span></div></div>
<p class="identity">Signed in as @identity.DisplayName · @identity.Actor</p>
</main>
@if (Model.Selected != null)
{
    var selected = Model.Selected;
    var close = Model.Url(null, "");
<a class="drawer-backdrop" href="@close" aria-label="Close computer details"></a>
<aside class="drawer" aria-labelledby="computer-title"><div class="drawer-top"><div class="drawer-breadcrumb">Windows LAPS <span>/</span> @selected.Name</div><a class="close-button" href="@close" aria-label="Close computer details">×</a></div>
<div class="drawer-heading"><span class="device-icon large" aria-hidden="true"></span><div><h2 id="computer-title">@selected.Name</h2><p>@WindowsLapsModel.SourceName(selected.Source)@(string.IsNullOrEmpty(selected.OperatingSystem) ? "" : " · " + selected.OperatingSystem)</p>@if (!string.IsNullOrEmpty(selected.Description)) {<p class="drawer-description">@selected.Description</p>}</div></div>
<nav class="tabs" aria-label="Computer sections"><a class="@(Model.Tab == "password" ? "active" : "")" href="@Model.Url(selected, "password")">Password</a><a class="@(Model.Tab == "history" ? "active" : "")" href="@Model.Url(selected, "history")">History</a><a class="@(Model.Tab == "details" ? "active" : "")" href="@Model.Url(selected, "details")">Details</a></nav>
<div class="drawer-body">
@if (Model.Tab == "details")
{
<section class="detail-section"><h3>Directory object</h3><dl><dt>Name</dt><dd>@selected.Name</dd>
@if (!string.IsNullOrEmpty(selected.Description)) {<dt>Description</dt><dd>@selected.Description</dd>}
@if (!string.IsNullOrEmpty(selected.DnsName)) {<dt>DNS name</dt><dd>@selected.DnsName</dd>}
@if (!string.IsNullOrEmpty(selected.DistinguishedName)) {<dt>Distinguished name</dt><dd class="mono">@selected.DistinguishedName</dd>}
<dt>@(selected.Source == "entra" ? "Entra device ID" : "Object GUID")</dt><dd class="mono">@selected.Id</dd>
@if (selected.ExpiresUtc.HasValue) {<dt>@(selected.Source == "entra" ? "Next rotation" : "Windows LAPS expiry")</dt><dd>@CredentialHtml.Utc(selected.ExpiresUtc)</dd>}
@if (selected.LegacyExpiresUtc.HasValue) {<dt>Legacy LAPS expiry</dt><dd>@CredentialHtml.Utc(selected.LegacyExpiresUtc)</dd>}
@if (selected.LastBackupUtc.HasValue) {<dt>Last backup</dt><dd>@CredentialHtml.Utc(selected.LastBackupUtc)</dd>}
</dl></section>
<p class="helper">SLAPS only reads these values. Rotate or reset passwords with the Windows LAPS tools (Reset-LapsPassword, Intune, Entra admin center).</p>
}
else if (Model.Revealed == null)
{
<section class="current-card"><h3>@(Model.Tab == "history" ? "Previous passwords" : "Current password")</h3><p>@(Model.Tab == "history" ? "Older passwords kept by Windows LAPS (password history). They are read and decrypted only when you ask for them." : "The password is read live from " + WindowsLapsModel.SourceName(selected.Source) + " and decrypted on this server when needed.")</p>
<form method="post" action="@Model.Url(selected, Model.Tab)" asp-antiforgery="true"><button class="button large" type="submit" name="action" value="reveal">@(Model.Tab == "history" ? "Show password history" : "Show password")</button></form></section>
}
else
{
    var shown = Model.Shown().ToList();
    var index = 0;
    foreach (var error in Model.Revealed.Errors) {<p class="notice danger">@error</p>}
    if (Model.Mixed && Model.Tab == "password") {<p class="notice">This computer has both a <strong>Windows LAPS</strong> and a <strong>legacy LAPS</strong> password (mixed operation, e.g. during migration). The one that changed last is active on the device; compare the dates below.</p>}
    if (shown.Count == 0)
    {
<div class="empty-panel"><h3>@(Model.Tab == "history" ? "No password history" : "No password found")</h3><p>@(Model.Tab == "history" ? "Windows LAPS keeps history only for encrypted passwords and when PasswordHistorySize is set." : "No LAPS password is stored for this computer, or the service account cannot read it.")</p></div>
    }
<div class="@(Model.Tab == "history" ? "history-credentials" : "")">@foreach (var credential in shown) {@Model.Card(credential, index++)}</div>
<p class="helper">Close this page after use. Every reveal is audited.</p>
}
</div><footer class="drawer-footer">Read-only directory lookup · Access is audited</footer></aside>
}
