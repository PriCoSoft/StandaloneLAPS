<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Values are written by Install-SlapsServer.ps1. See README.md for their meaning. -->
  <appSettings>
    <add key="VaultDataDirectory" value="~/App_Data/Vault" />
    <add key="PublicBaseUrl" value="" />
    <add key="PortalAuthMode" value="Entra" />
    <add key="EntraTenantId" value="" />
    <add key="EntraClientId" value="" />
    <add key="PortalAllowedNetworks" value="" />
    <add key="OutboundProxyUrl" value="" />
    <add key="IssuingCaSha256" value="" />
    <add key="CrlDistributionUrl" value="" />
    <add key="EnableWebDecryption" value="false" />
    <add key="RecoveryCertificateSha256" value="" />
  </appSettings>
  <system.web>
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
    <compilation debug="false" targetFramework="4.7.2">
      <assemblies>
        <add assembly="System.IO.Compression, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.7.2" maxRequestLength="64" executionTimeout="30" enableVersionHeader="false" />
    <customErrors mode="On" />
    <authentication mode="None" />
    <httpCookies httpOnlyCookies="true" requireSSL="true" sameSite="Lax" />
    <sessionState cookieless="UseCookies" timeout="10" cookieSameSite="Lax" />
    <pages enableViewStateMac="true" validateRequest="true" />
  </system.web>
  <system.webServer>
    <modules><remove name="WebDAVModule" /></modules>
    <handlers>
      <remove name="WebDAV" />
      <add name="StandaloneLapsApi" path="api.aspx" verb="GET,PUT,POST" type="System.Web.UI.PageHandlerFactory" resourceType="File" preCondition="integratedMode" />
    </handlers>
    <directoryBrowse enabled="false" />
    <staticContent>
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>
    <defaultDocument><files><clear /><add value="Default.aspx" /></files></defaultDocument>
    <security><requestFiltering><requestLimits maxAllowedContentLength="65536" /></requestFiltering></security>
    <httpProtocol><customHeaders><remove name="X-Powered-By" /></customHeaders></httpProtocol>
  </system.webServer>
</configuration>
